  "properties":[
    {"$GMObjectProperty":"v2","%Name":"mode","filters":[],"listItems":[
        "trigger_modes.custom",
        "trigger_modes.transition",
        "trigger_modes.battle",
      ],"multiselect":false,"name":"mode","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"trigger_modes.custom","varDescription":"Defines what behavior the trigger will have when you touch it.\r\nTRANSITION mode will fade the screen to black, go to the room you specified (which can be the same room), and teleport the player to the position of the dummy with the index you selected.\r\nBATTLE mode does nothing for now.\r\nCUSTOM mode doesn't have any unique behavior. It just ignores all the mode-specific functionality. To do anything, it's dependant on the Custom Function which executes regardless of the chosen mode.","varFriendlyName":"Trigger Mode","varType":6,},
    {"$GMObjectProperty":"v2","%Name":"transition_target","filters":[],"listItems":[],"multiselect":false,"name":"transition_target","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"{ room : \"curr\", dummy_index : 0 }","varDescription":"A struct that contains the parameters only used for the TRANSITION mode.\r\n\"room\" contains the desired room to go to when the player collides with this instance. If set to \"curr\" it will not change the room, and will only teleport the player, that way this trigger is both a DOOR and a TELEPORT.\r\n\"dummy\" is the index of the dummy that the player will spawn at in the target room. If no dummies match with this parameter the position will be kept the same when switching rooms.","varFriendlyName":"Transition Target","varType":4,},
    {"$GMObjectProperty":"v2","%Name":"battle_target","filters":[],"listItems":[],"multiselect":false,"name":"battle_target","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"{}","varDescription":"This would contain the parameters only used for the BATTLE mode. This function is not implemented yet.","varFriendlyName":"Battle Target","varType":4,},
    {"$GMObjectProperty":"v2","%Name":"custom_function","filters":[],"listItems":[],"multiselect":false,"name":"custom_function","rangeEnabled":false,"rangeMax":10.0,"rangeMin":0.0,"resourceType":"GMObjectProperty","resourceVersion":"2.0","value":"function () {} ","varDescription":"This function is always called regardless of which mode you pick, after the mode behavior is executed.\r\nIt should be defined in the Creation Code for this instance.","varFriendlyName":"Custom Function","varType":4,},
  ],
